<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_flirt_picker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Bottom Sheet drag handle pill -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="?attr/colorOnSurfaceVariant"
        android:alpha="0.4" />

    <!-- Dynamic Header Row (Back button + Title/Subtitle + Category Thumbnail) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_flirt_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/cancel"
            android:visibility="gone"
            app:icon="@drawable/ic_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_flirt_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flirt_picker_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_flirt_category_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Premier contact? Choisis l'une des salutations suivantes."
                tools:visibility="visible" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_flirt_header_thumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/img_flirt_header_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_flirts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- STEP 1: 3-Column Square Category Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_flirt_categories"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:nestedScrollingEnabled="true" />

    <!-- STEP 2: Category Flirt Choices + Sticky Send Button -->
    <LinearLayout
        android:id="@+id/container_flirt_choices"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_picker_flirts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:nestedScrollingEnabled="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_flirt"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="12dp"
            android:text="@string/send"
            android:enabled="false"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_send_24"
            app:iconGravity="textStart" />

    </LinearLayout>

</LinearLayout>
